@startsalt File Tree Template
{
  {T
    + root/
    ++ folder1/
    +++ file1.txt
    +++ file2.txt
    ++ folder2/
    +++ subfolder/
    ++++ file3.txt
    ++ file4.txt
  }
}
@endsalt
